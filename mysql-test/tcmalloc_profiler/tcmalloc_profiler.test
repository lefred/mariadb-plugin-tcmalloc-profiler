--source include/not_embedded.inc

--disable_query_log
call mtr.add_suppression("Plugin 'tcmalloc_.*' is of maturity level experimental while the server is");
--enable_query_log

--remove_files_wildcard $MYSQLTEST_VARDIR/tmp tcmalloc_profiler_cpu
--remove_files_wildcard $MYSQLTEST_VARDIR/tmp tcmalloc_profiler_dump*

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR $TCMALLOC_PPROF_BINARY PPROF_BINARY
SHOW GLOBAL VARIABLES LIKE 'tcmalloc_profiler_%';
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
SELECT TCMALLOC_PROFILER();
SELECT TCMALLOC_CPUPROF_STOP();
SELECT TCMALLOC_CPUPROF_FLUSH();
SELECT TCMALLOC_MEMPROF_STOP();
SELECT TCMALLOC_MEMPROF_DUMP();

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT TCMALLOC_MEMPROF_START();
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
SELECT TCMALLOC_MEMPROF_DUMP();
SELECT TCMALLOC_MEMPROF_STOP();
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';

--file_exists $MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_dump.0001.heap
SELECT LEFT(TCMALLOC_MEMPROF_REPORT('text', 1), 6) AS text_report_start;
SELECT LEFT(TCMALLOC_MEMPROF_REPORT('dot'), 7) AS dot_report_start;
SELECT TCMALLOC_PROFILER_CLEANUP();
--exec test ! -e $MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_dump.0001.heap

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT TCMALLOC_CPUPROF_START();
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
--disable_query_log
--disable_result_log
SELECT BENCHMARK(500000, SHA2('abcdef', 256));
--enable_result_log
--enable_query_log
SELECT TCMALLOC_CPUPROF_FLUSH();
SELECT TCMALLOC_CPUPROF_STOP();
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';

--file_exists $MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_cpu
SELECT LEFT(TCMALLOC_CPUPROF_REPORT('text', 1), 6) AS cpu_text_report_start;
SELECT LEFT(TCMALLOC_CPUPROF_REPORT('dot'), 7) AS cpu_dot_report_start;
SELECT TCMALLOC_PROFILER_CLEANUP();
--exec test ! -e $MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_cpu
