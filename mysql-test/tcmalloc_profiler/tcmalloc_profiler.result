SHOW GLOBAL VARIABLES LIKE 'tcmalloc_profiler_%';
Variable_name	Value
tcmalloc_profiler_dump_path	MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_dump
tcmalloc_profiler_pprof_binary	/usr/bin/pprof
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
Variable_name	Value
Tcmalloc_profiler_memory_status	OFF
SELECT TCMALLOC_PROFILER();
TCMALLOC_PROFILER()
TCMalloc Profiler plugin by lefred, current allocator: tcmalloc
SELECT TCMALLOC_MEMPROF_STOP();
TCMALLOC_MEMPROF_STOP()
HeapProfiler not running
SELECT TCMALLOC_MEMPROF_DUMP();
TCMALLOC_MEMPROF_DUMP()
HeapProfiler not running
SELECT TCMALLOC_MEMPROF_START();
TCMALLOC_MEMPROF_START()
HeapProfiler started, use MEMPROF_STOP() to stop it, dumps to MYSQLTEST_VARDIR/tmp/tcmalloc_profiler_dump.NNNN.heap
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
Variable_name	Value
Tcmalloc_profiler_memory_status	ON
SELECT TCMALLOC_MEMPROF_DUMP();
TCMALLOC_MEMPROF_DUMP()
HeapProfiler dump requested
SELECT TCMALLOC_MEMPROF_STOP();
TCMALLOC_MEMPROF_STOP()
HeapProfiler stopped
SHOW GLOBAL STATUS LIKE 'tcmalloc_profiler_%';
Variable_name	Value
Tcmalloc_profiler_memory_status	OFF
SELECT LEFT(TCMALLOC_MEMPROF_REPORT('text', 1), 6) AS text_report_start;
text_report_start
Total:
SELECT LEFT(TCMALLOC_MEMPROF_REPORT('dot'), 7) AS dot_report_start;
dot_report_start
digraph
SELECT TCMALLOC_PROFILER_CLEANUP();
TCMALLOC_PROFILER_CLEANUP()
Profiling data has been cleaned up
